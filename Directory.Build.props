<Project>
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <OutputPath>$(MSBuildProjectDirectory)/../bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GamePath Condition="'$(GamePath)' == ''">$(NIVALIS_GAME_PATH)</GamePath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Cigarette'">
    <EnableApi Condition="'$(EnableApi)' == ''">false</EnableApi>
    <BuildFlavor Condition="'$(EnableApi)' == 'true'">api</BuildFlavor>
    <BuildFlavor Condition="'$(EnableApi)' != 'true'">standalone</BuildFlavor>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)/obj/$(BuildFlavor)/</BaseIntermediateOutputPath>
    <OutputPath>$(MSBuildProjectDirectory)/../bin/$(BuildFlavor)/</OutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)/obj/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
