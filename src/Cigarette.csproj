<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Nivalis.Cigarette</AssemblyName>
    <Version>1.4.0</Version>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableApi)' == 'true'">
    <DefineConstants>$(DefineConstants);CIGARETTE_API</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableApi)' != 'true'">
    <Compile Remove="ApiService.cs;GameApiRuntime.cs" />
  </ItemGroup>
  <Target Name="ValidateBuildFlavor" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(EnableApi)' != 'true' and '$(EnableApi)' != 'false'" Text="EnableApi must be true or false." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="../api/Cigarette.Api.csproj" Condition="'$(EnableApi)' == 'true'" />
    <EmbeddedResource Include="../assets/icons/*.png" LogicalName="Cigarette.Icons.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../assets/*.wav" LogicalName="Cigarette.Audio.%(Filename)%(Extension)" />
    <Reference Include="Nivalis.ModCompanion" HintPath="$(GamePath)/BepInEx/plugins/Nivalis.ModCompanion.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GamePath)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="BepInEx.Core" HintPath="$(GamePath)/BepInEx/core/BepInEx.Core.dll" Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(GamePath)/BepInEx/core/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(GamePath)/BepInEx/core/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GamePath)/BepInEx/interop/*.dll" Private="false" />
  </ItemGroup>
</Project>
